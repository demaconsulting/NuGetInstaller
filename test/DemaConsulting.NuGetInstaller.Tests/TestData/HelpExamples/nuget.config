<?xml version="1.0" encoding="utf-8"?>
<!--
  The package sources of the help examples. The example-runner test copies this file into the folder of
  every example command, and zips each folder of feed-content into a package of the local folder feed
  'feed'. Clearing the other sources and moving the global packages folder keeps the examples offline and
  out of the package cache of the machine. Relative paths are relative to the folder of this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="examples" value="feed" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="global-packages" />
  </config>
</configuration>
